{
  "name": "jarvis-parlement",
  "productName": "Jarvis Parlement",
  "version": "1.5.2",
  "description": "Assistant parlementaire complet : veille, recherche, rédaction, courriels, agenda — avec un cerveau qui apprend vos préférences.",
  "main": "main.js",
  "author": "Jarvis Parlement",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js && node scripts/test-agenda.js && node scripts/test-mailbox.js && node scripts/test-mail.js && node scripts/test-jarvis.js && node scripts/test-wake.js && node scripts/test-mailwatch.js",
    "icon": "node scripts/make-icon.js",
    "dist": "bash scripts/build-native.sh && electron-builder --mac --publish never",
    "build:native": "bash scripts/build-native.sh"
  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.7.0",
    "mammoth": "^1.8.0",
    "nodemailer": "^7.0.0",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "be.jarvis.parlement",
    "productName": "Jarvis Parlement",
    "artifactName": "Jarvis-Parlement-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis écoute tes demandes vocales.",
        "NSCalendarsUsageDescription": "Jarvis peut lire ton agenda.",
        "NSSpeechRecognitionUsageDescription": "Jarvis comprend ce que tu lui dis à voix haute."
      }
    },
    "dmg": {
      "title": "Jarvis Parlement",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": [
      {
        "from": "native/build/jarvis-listen",
        "to": "jarvis-listen"
      },
      {
        "from": "native/build/jarvis-speak",
        "to": "jarvis-speak"
      },
      {
        "from": "native/build/voices",
        "to": "voices"
      }
    ]
  }
}
